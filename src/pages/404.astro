---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
const d = t('en');
---
<Base lang="en" title={d.notFound.title}>
  <section class="simple">
    <div class="wrap">
      <h1>{d.notFound.title}</h1>
      <p>{d.notFound.text}</p>
      <p><a href="/">Go to the homepage</a> · <a href="/nl/" lang="nl">Naar de Nederlandse homepage</a></p>
    </div>
  </section>
</Base>
