---
import { NL_LIVE } from '../../../config';
import UnderConstruction from '../../../components/UnderConstruction.astro';
import { getCollection } from 'astro:content';
import ArticlePage from '../../../components/ArticlePage.astro';
export async function getStaticPaths() {
  const news = await getCollection('news', (e) => !e.data.draft);
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
{NL_LIVE ? (<ArticlePage lang="nl" entry={entry} />) : <UnderConstruction page={`news/${entry.id}`} />}
