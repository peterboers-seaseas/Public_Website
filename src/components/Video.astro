---
// Video with custom controls.
// trigger="scroll": starts muted and looping once the visitor starts scrolling and the video is in view;
//                   pauses when scrolled out of view. Visitors switch the sound on themselves.
// trigger="click":  shows a play button; plays with sound after a click.
// Visitors with "reduce motion" switched on are never auto-played.
import fs from 'node:fs';
import path from 'node:path';
import { t, withBase, type Lang } from '../i18n';
interface Props { lang: Lang; src: string; poster?: string; label: string; trigger?: 'scroll' | 'click'; variant?: 'terminal' | 'location' }
const { lang, src, poster, label, trigger = 'scroll', variant = 'terminal' } = Astro.props;
const d = t(lang);
const has = (p?: string) => !!p && fs.existsSync(path.join(process.cwd(), 'public', p));
const hasVideo = has(src);
const posterSrc = has(poster) ? withBase(poster!) : undefined;
const pauseIcon = '<path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>';
const playIcon = '<path d="M7 4l13 8-13 8z"></path>';
const mutedIcon = '<path d="M11 5L6 9H3v6h3l5 4z"></path><path d="M16 9l5 6M21 9l-5 6"></path>';
const soundIcon = '<path d="M11 5L6 9H3v6h3l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>';
---
<div class={`video-frame ${variant}`} data-video data-trigger={trigger}
  data-l-pause={d.video.pause} data-l-play={d.video.play} data-l-on={d.video.soundOn} data-l-off={d.video.soundOff}
  data-l-on-label={d.video.soundOnLabel} data-l-off-label={d.video.soundOffLabel}
  data-i-pause={pauseIcon} data-i-play={playIcon} data-i-muted={mutedIcon} data-i-sound={soundIcon}>
  {hasVideo
    ? <video src={withBase(src)} poster={posterSrc} muted loop playsinline preload="metadata" aria-label={label}></video>
    : <div class="video-ph">[{label}]</div>}

  {trigger === 'click' && (
    <button type="button" class="play-overlay" data-overlay aria-label={d.video.play}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
      {d.video.play}
    </button>
  )}

  <div class:list={['video-controls', { hidden: trigger === 'click' || !hasVideo }]} data-controls>
    <button type="button" class="vc-btn" data-toggle aria-label={d.video.play}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true" set:html={playIcon}></svg>
    </button>
    <button type="button" class="vc-btn" data-mute aria-label={d.video.soundOnLabel}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#09029B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={mutedIcon}></svg>
      <span class="vc-label">{d.video.soundOn}</span>
    </button>
    <button type="button" class="vc-seek" data-seek aria-label={d.video.seek}><span class="vc-track"><span data-progress></span></span></button>
    <span class="vc-time" data-time aria-hidden="true">0:00</span>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fmt = (s: number) => { s = Math.max(0, Math.floor(s || 0)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const video = root.querySelector('video');
    if (!video) return; // placeholder only, no file yet
    const L = root.dataset;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const mute = root.querySelector<HTMLButtonElement>('[data-mute]')!;
    const seek = root.querySelector<HTMLButtonElement>('[data-seek]')!;
    const bar = root.querySelector<HTMLElement>('[data-progress]')!;
    const time = root.querySelector<HTMLElement>('[data-time]')!;
    const overlay = root.querySelector<HTMLButtonElement>('[data-overlay]');
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    let started = false;
    let userPaused = false;

    const showState = () => {
      const playing = !video.paused;
      toggle.setAttribute('aria-label', playing ? L.lPause! : L.lPlay!);
      toggle.querySelector('svg')!.innerHTML = playing ? L.iPause! : L.iPlay!;
    };
    const showSound = () => {
      mute.setAttribute('aria-label', video.muted ? L.lOnLabel! : L.lOffLabel!);
      mute.querySelector('svg')!.innerHTML = video.muted ? L.iMuted! : L.iSound!;
      mute.querySelector('.vc-label')!.textContent = video.muted ? L.lOn! : L.lOff!;
    };
    const showTime = () => {
      const d = video.duration || 0;
      bar.style.width = d ? `${(video.currentTime / d) * 100}%` : '0';
      time.textContent = `${fmt(video.currentTime)} / ${fmt(d)}`;
    };
    const play = () => video.play().catch(() => {});

    if (root.dataset.trigger === 'scroll' && !reduce.matches) {
      const inView = () => {
        const r = video.getBoundingClientRect();
        const h = window.innerHeight || document.documentElement.clientHeight;
        return r.bottom > h * 0.2 && r.top < h * 0.8;
      };
      const events = ['scroll', 'wheel', 'touchmove'];
      const onFirstScroll = () => {
        if (started) return;
        started = true;
        events.forEach((e) => window.removeEventListener(e, onFirstScroll, true));
        if (inView()) play();
      };
      events.forEach((e) => window.addEventListener(e, onFirstScroll, { passive: true, capture: true }));
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => entries.forEach((en) => {
          if (!started) return;
          if (en.isIntersecting && !userPaused) play();
          if (!en.isIntersecting && !video.paused) video.pause();
        }), { threshold: 0.35 }).observe(video);
      }
    }

    overlay?.addEventListener('click', () => {
      overlay.remove();
      controls.classList.remove('hidden');
      started = true;
      video.muted = false;
      play();
    });
    toggle.addEventListener('click', () => {
      started = true;
      if (video.paused) { userPaused = false; play(); } else { userPaused = true; video.pause(); }
    });
    mute.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) { video.volume = 1; started = true; userPaused = false; if (video.paused) play(); }
    });
    seek.addEventListener('click', (e) => {
      if (!video.duration) return;
      const r = seek.getBoundingClientRect();
      video.currentTime = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)) * video.duration;
    });
    // Controls fade out ~3 s after the video starts and come back on mouse movement, tap or keyboard focus.
    let hideTimer: number | undefined;
    const wake = () => {
      root.classList.remove('idle');
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        if (!video.paused && !root.contains(document.activeElement)) root.classList.add('idle');
      }, 3000);
    };
    ['mousemove', 'touchstart', 'focusin'].forEach((e) => root.addEventListener(e, wake, { passive: true }));
    root.addEventListener('mouseleave', () => { if (!video.paused) { window.clearTimeout(hideTimer); hideTimer = window.setTimeout(() => root.classList.add('idle'), 800); } });
    video.addEventListener('play', () => { showState(); wake(); });
    video.addEventListener('pause', () => { showState(); window.clearTimeout(hideTimer); root.classList.remove('idle'); });
    video.addEventListener('volumechange', showSound);
    video.addEventListener('timeupdate', showTime);
    video.addEventListener('loadedmetadata', showTime);
    showState();
    showSound();
  });
</script>
