---
// Video with custom controls. `autoplay` starts muted and looping (browsers only allow muted autoplay).
// Visitors with "reduce motion" switched on see the poster frame instead.
import fs from 'node:fs';
import path from 'node:path';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; src: string; poster?: string; label: string; autoplay?: boolean; variant?: 'terminal' | 'location' }
const { lang, src, poster, label, autoplay = false, variant = 'terminal' } = Astro.props;
const d = t(lang);
const has = (p?: string) => !!p && fs.existsSync(path.join(process.cwd(), 'public', p));
const hasVideo = has(src);
const posterSrc = has(poster) ? poster : undefined;
const pauseIcon = '<path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>';
const playIcon = '<path d="M8 5l12 7-12 7z"></path>';
---
<div class={`video-frame ${variant}`} data-video data-autoplay={autoplay ? 'true' : 'false'}
  data-l-pause={d.video.pause} data-l-play={d.video.play} data-l-on={d.video.soundOn} data-l-off={d.video.soundOff}
  data-i-pause={pauseIcon} data-i-play={playIcon}>
  {hasVideo
    ? <video src={src} poster={posterSrc} muted loop={autoplay} playsinline preload={autoplay ? 'auto' : 'metadata'} autoplay={autoplay} aria-label={label}></video>
    : <div class="video-ph">[{label}{autoplay ? (lang === 'nl' ? ': speelt automatisch af, zonder geluid' : ': plays automatically, muted') : ''}]</div>}

  {!autoplay && (
    <button type="button" class="play-overlay" data-overlay aria-label={d.video.play}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M8 5l12 7-12 7z"></path></svg>
      {d.video.play}
    </button>
  )}

  <div class:list={['video-controls', { hidden: !autoplay }]} data-controls>
    <button type="button" class="vc-btn" data-toggle aria-label={autoplay ? d.video.pause : d.video.play}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true" set:html={autoplay ? pauseIcon : playIcon}></svg>
    </button>
    <button type="button" class="vc-btn" data-mute aria-pressed="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#09029B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4z"></path><path d="M16 9l5 6M21 9l-5 6"></path></svg>
      <span class="vc-label">{d.video.soundOn}</span>
    </button>
    <div class="vc-progress" aria-hidden="true"><span data-progress></span></div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const video = root.querySelector('video');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const mute = root.querySelector<HTMLButtonElement>('[data-mute]')!;
    const overlay = root.querySelector<HTMLButtonElement>('[data-overlay]');
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const bar = root.querySelector<HTMLElement>('[data-progress]')!;
    const L = root.dataset;
    if (!video) return; // placeholder only, no file yet

    const showState = () => {
      const playing = !video.paused;
      toggle.setAttribute('aria-label', playing ? L.lPause! : L.lPlay!);
      toggle.querySelector('svg')!.innerHTML = playing ? L.iPause! : L.iPlay!;
    };
    const showSound = () => {
      mute.setAttribute('aria-pressed', String(!video.muted));
      mute.querySelector('.vc-label')!.textContent = video.muted ? L.lOn! : L.lOff!;
    };

    if (root.dataset.autoplay === 'true') {
      if (reduce.matches) { video.pause(); video.removeAttribute('autoplay'); }
      else { video.play().catch(() => {}); }
    }

    overlay?.addEventListener('click', () => {
      overlay.remove();
      controls.classList.remove('hidden');
      video.muted = false;
      video.play().catch(() => {});
      showSound();
    });
    toggle.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    mute.addEventListener('click', () => { video.muted = !video.muted; showSound(); });
    video.addEventListener('play', showState);
    video.addEventListener('pause', showState);
    video.addEventListener('timeupdate', () => {
      if (video.duration) bar.style.width = `${(video.currentTime / video.duration) * 100}%`;
    });
    showState();
    showSound();
  });
</script>
