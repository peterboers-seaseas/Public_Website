---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import Slider from './Slider.astro';
import Video from './Video.astro';
import Media from './Media.astro';
import NewsMedia from './NewsMedia.astro';
import { t, url, articleUrl, co2, newsDate, withBase, type Lang } from '../i18n';
import { VIDEOS, FORM_ACTION, PARTNERS } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const nl = lang === 'nl';

const news = (await getCollection('news', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const MAPS = ['map-1-site-v4', 'map-2-port-region-v2', 'map-3-northwest-europe-v3'];
const picto = (name: string) => withBase(`/images/pictograms/${name}.png`);
const stepIcons = ['emitter', null, 'terminal', 'vessel', 'sink'];
const stepClass = ['', '', 'is-terminal', '', 'is-storage'];
const transport = ['pipeline', 'truck', 'rail', 'barge'];
const netlify = !FORM_ACTION;
const liPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
---

<!-- 1. Title -->
<section class="hero" aria-labelledby="hero-title">
  <picture>
    <source media="(max-width: 900px)" type="image/webp" srcset={withBase('/images/terminal-3d-1100.webp')} />
    <source media="(max-width: 900px)" srcset={withBase('/images/terminal-3d-1100.jpg')} />
    <source type="image/webp" sizes="100vw"
      srcset={`${withBase('/images/terminal-3d-2560.webp')} 2560w, ${withBase('/images/terminal-3d-3840.webp')} 3840w`} />
    <img class="hero-bg" src={withBase('/images/terminal-3d-2560.jpg')} sizes="100vw"
      srcset={`${withBase('/images/terminal-3d-2560.jpg')} 2560w, ${withBase('/images/terminal-3d-3840.jpg')} 3840w`}
      alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="wrap">
    <h1 id="hero-title" set:html={co2(d.hero.title)} />
    <div class="hero-row">
      <div class="hero-sub">
        <p class="hero-strong" set:html={co2(d.hero.sub1)} />
        <p set:html={co2(d.hero.sub2)} />
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#contact">{d.hero.ctaPrimary}</a>
        <a class="btn btn-outline" href="#video">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
          {d.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 2. Terminal video: starts muted when the visitor scrolls -->
<section id="video" class="video-section" aria-label={d.video.title}>
  <div class="wrap">
    <figure>
      <Video lang={lang} src={VIDEOS.terminal.src} poster={VIDEOS.terminal.poster} label={d.video.label} trigger="scroll" variant="terminal" />
      <figcaption class="video-caption"><strong>{d.video.title}</strong><em>{d.video.caption}</em></figcaption>
    </figure>
  </div>
</section>

<!-- 3. News and publications -->
<Section id="news" label={d.labels.news}>
  <Slider lang={lang} label={d.labels.news}>
    {news.map((item) => (
      <article class="news-card">
        <NewsMedia media={item.data.media} />
        <div class="body">
          <div class="news-meta">{newsDate(lang, item.data.date)}, {item.data.type}</div>
          <h3 set:html={co2(item.data.title)} />
          <a class="card-link" href={articleUrl(lang, item.id)}>{d.news.readArticle}<span class="sr-only">: {item.data.title}</span><span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </Slider>
  <div class="more-links">
    <a class="btn btn-outline" href={url(lang, 'news')}>{d.news.all}</a>
    <a class="li-icon news-li" href={d.contact.linkedin_url} aria-label={d.news.linkedin}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true"><path d={liPath}></path></svg>
    </a>
  </div>
</Section>

<!-- 4. About SeaSeaS -->
<Section id="about" label={d.labels.about}>
  <p class="lead" set:html={co2(d.about.headline)} />
  <p class="about-body" set:html={co2(d.about.body)} />
  <div class="about-grid">
    {d.about.cols.map((c: { title: string; text: string; logo?: string; link?: string }) => (
      <div>
        <h3>{c.title}</h3>
        <p set:html={co2(c.text)} />
        {c.logo && c.link && (
          <a class="about-logo" href={c.link} target="_blank" rel="noopener" aria-label={`${c.title} website`}>
            <img src={withBase(c.logo)} alt={c.title} width="140" height="36" loading="lazy" />
          </a>
        )}
      </div>
    ))}
  </div>
  <div class="partners">
    <p class="partners-title">{d.about.partnersTitle}</p>
    <div class="marquee">
      <div class="marquee-inner">
        {[0, 1].map((copy) => (
          <ul class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {PARTNERS.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined} aria-label={`${p.name} website`}>
                  <img src={withBase(p.logo)} alt={copy === 1 ? '' : p.name} width={Math.round(p.h * p.ar)} height={p.h} style={`--h: ${p.h}px; --w: ${Math.round(p.h * p.ar)}px`} loading="eager" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</Section>

<!-- 5. For emitters -->
<Section id="emitters" label={d.labels.emitters}>
  <p class="lead">{d.emitters.lead}</p>
  <p class="intro" set:html={co2(d.emitters.intro)} />
  <div class="cards">
    {d.emitters.cards.map((c) => (
      <div class="card">
        <img src={picto(c.icon)} alt="" loading="lazy" width="300" height="260" />
        <h3>{c.title}</h3>
        <p set:html={co2(c.text)} />
      </div>
    ))}
  </div>
  <div class="segments">
    <p class="segments-title">{d.emitters.segmentsTitle}</p>
    <ul class="seg-row">
      {d.emitters.segments.map((s) => (
        <li class="seg" tabindex="0">
          <img src={picto(s.icon)} alt="" loading="lazy" width="340" height="280" />
          <strong>{s.title}</strong>
          <span class="seg-tag" set:html={co2(s.tag)} />
          <span class="seg-tip" set:html={co2(s.text)} />
        </li>
      ))}
    </ul>
  </div>
</Section>

<!-- 6. How it works -->
<Section id="how" label={d.labels.how}>
  <p class="lead">{d.how.lead}</p>
  <p class="intro" set:html={co2(d.how.intro)} />
  <ol class="steps">
    {d.how.steps.map((s, i) => (
      <li class={`step ${stepClass[i]}`}>
        <span class="num" aria-hidden="true">{i + 1}</span>
        {stepIcons[i]
          ? <div class="step-picto"><img src={picto(stepIcons[i]!)} alt="" loading="lazy" /></div>
          : <div class="step-picto group">{transport.map((m) => <img src={picto(m)} alt="" loading="lazy" />)}</div>}
        <h3>{s.title}</h3>
        <p set:html={co2(s.text)} />
      </li>
    ))}
  </ol>
</Section>

<!-- 7. Location -->
<Section id="location" label={d.labels.location}>
  <p class="lead" set:html={co2(d.location.lead)} />
  <p class="intro" set:html={co2(d.location.text)} />
  <figure class="loc-maps" data-maps>
    <div class="loc-stage">
      {MAPS.map((m, i) => (
        <img class={i === 0 ? 'is-active' : ''} data-map={i}
          src={withBase(`/images/location/${m}-2400.webp`)}
          srcset={`${withBase(`/images/location/${m}-1200.webp`)} 1200w, ${withBase(`/images/location/${m}-2400.webp`)} 2400w`}
          sizes="(max-width: 1240px) 100vw, 1200px" width="2400" height="1350"
          alt={`${d.location.mapAlt} ${i + 1}: ${d.location.stages[i].title}. ${d.location.stages[i].text}`}
          loading={i === 0 ? 'eager' : 'lazy'} decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
      ))}
    </div>
    <figcaption>
      <ol class="stages">
        {d.location.stages.map((s, i) => (
          <li>
            <button type="button" class:list={['stage', { 'is-active': i === 0 }]} data-stage={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="stage-bar" aria-hidden="true"><span></span></span>
              <strong>{i + 1} · {s.title}</strong>{s.text}
            </button>
          </li>
        ))}
      </ol>
    </figcaption>
  </figure>
</Section>

<!-- 8. Project timeline -->
<Section id="timeline" label={d.labels.timeline}>
  <p class="lead" set:html={co2(d.timeline.lead)} />
  <div class="milestones">
    <p class="ms-title">{d.timeline.achieved}</p>
    <ul>
      {d.timeline.milestones.map((m) => (
        <li>
          <span class="ms-check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#09029B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span>
          <div>
            <div class="ms-when">{m.when}</div>
            <div class="ms-what">{m.title}</div>
            <div class="ms-text" set:html={co2(m.text)} />
            {m.article && <a href={articleUrl(lang, m.article)}>{d.timeline.readMore}<span class="sr-only">: {m.title}</span></a>}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <p class="ms-title ahead">{d.timeline.ahead}</p>
  <ol class="timeline">
    {d.timeline.items.map((it) => (
      <li class={it.status}>
        <div class="tl-bar" aria-hidden="true"></div>
        <div class="tl-when">{it.when}</div>
        <div class="tl-what" set:html={it.what} />
        {it.status === 'done' && <span class="tag done">{d.timeline.done}</span>}
        {it.status === 'next' && <span class="tag">{d.timeline.next}</span>}
      </li>
    ))}
  </ol>
</Section>

<!-- 9. Leadership -->
<Section id="team" label={d.labels.team}>
  <p class="lead">{d.team.photoTitle}</p>
  <p class="team-intro" set:html={co2(d.team.photoText)} />
  <Slider lang={lang} label={d.labels.team}>
    {team.map((p) => (
      <div class:list={['person', { linked: !!p.data.linkedin }]}>
        <Media src={p.data.photo} alt={p.data.name} label={nl ? 'Portret' : 'Portrait'} />
        <div class="person-body">
          <h3>{p.data.name}</h3>
          <p>{nl ? p.data.role_nl : p.data.role_en}</p>
          {p.data.linkedin && (
            <a class="li-icon person-link" href={p.data.linkedin} target="_blank" rel="noopener" aria-label={`${p.data.name} ${d.team.onLinkedin}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true"><path d={liPath}></path></svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </Slider>
</Section>

<!-- 10. Contact -->
<section id="contact" class="contact" aria-labelledby="contact-label">
  <div class="contact-panel">
    <h2 class="rh" id="contact-label">{d.labels.contact}</h2>
    <p class="contact-title" set:html={co2(d.contact.title)} />
    <p set:html={co2(d.contact.text)} />
    <address>
      {d.contact.office.map((l) => <>{l}<br /></>)}
      <a href={`mailto:${d.contact.email_address}`}>{d.contact.email_address}</a>
    </address>
    <a class="li-icon white" href={d.contact.linkedin_url} aria-label={d.contact.linkedinLabel}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d={liPath}></path></svg>
    </a>
  </div>
  <form class="contact-form" name="contact" method="POST"
    action={FORM_ACTION || (nl ? withBase('/nl/?verzonden=1#contact') : withBase('/?sent=1#contact'))}
    data-netlify={netlify ? 'true' : undefined} netlify-honeypot={netlify ? '_gotcha' : undefined}>
    {netlify && <input type="hidden" name="form-name" value="contact" />}
    <input type="hidden" name="language" value={lang} />
    <p class="hidden"><label>Leave empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>
    <label class="field">{d.contact.name}<input type="text" name="name" autocomplete="name" required /></label>
    <label class="field">{d.contact.company}<input type="text" name="company" autocomplete="organization" /></label>
    <label class="field">{d.contact.email}<input type="email" name="email" autocomplete="email" required /></label>
    <label class="field">{d.contact.message}<textarea name="message" rows="3" required></textarea></label>
    <label class="consent"><input type="checkbox" name="consent" required /><span set:html={d.contact.consent.replace('{privacy}', url(lang, 'privacy'))} /></label>
    <button class="btn btn-primary" type="submit">{d.contact.send}</button>
    <p class="hidden" role="status" data-thanks>{d.contact.thanks}</p>
  </form>
</section>

<script>
  // Location maps: roll through the three maps; hovering (or focusing/tapping) a description shows that map.
  document.querySelectorAll<HTMLElement>('[data-maps]').forEach((fig) => {
    const imgs = [...fig.querySelectorAll<HTMLImageElement>('[data-map]')];
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[data-stage]')];
    const DWELL = 6000;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, timer = 0, held = false, visible = false;
    const show = (i: number) => {
      cur = i;
      imgs.forEach((im, k) => { im.classList.toggle('is-active', k === i); im.toggleAttribute('aria-hidden', k !== i); });
      tabs.forEach((b, k) => { b.classList.toggle('is-active', k === i); b.setAttribute('aria-pressed', String(k === i)); });
    };
    const stop = () => { clearTimeout(timer); fig.classList.remove('is-playing'); };
    const play = () => {
      stop();
      if (still || held || !visible || document.hidden) return;
      void fig.offsetWidth; // restart the progress bar animation
      fig.classList.add('is-playing');
      timer = window.setTimeout(() => { show((cur + 1) % imgs.length); play(); }, DWELL);
    };
    fig.style.setProperty('--dwell', `${DWELL}ms`);
    tabs.forEach((b, i) => {
      const hold = () => { held = true; stop(); show(i); };
      b.addEventListener('mouseenter', hold);
      b.addEventListener('focus', hold);
      b.addEventListener('click', hold);
    });
    const release = () => { held = false; play(); };
    fig.querySelector('.stages')?.addEventListener('mouseleave', release);
    fig.addEventListener('focusout', (e) => { if (!fig.contains(e.relatedTarget as Node)) release(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? play() : stop(); }, { threshold: 0.4 }).observe(fig);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
  });

  // Contact form: light spam check, and remember the language for the thank-you redirect.
  const KEY = 'seaseas-form-lang';
  const form = document.querySelector<HTMLFormElement>('form.contact-form');
  const loaded = Date.now();
  form?.addEventListener('submit', (e) => {
    const trap = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
    if ((trap && trap.value) || Date.now() - loaded < 3000) { e.preventDefault(); return; }
    try { localStorage.setItem(KEY, document.documentElement.lang); } catch {}
  });

  // After sending, Form.taxi returns visitors to the English page; send Dutch visitors to the Dutch page.
  if (/[?&](sent|verzonden)=1/.test(location.search)) {
    let lang = '';
    try { lang = localStorage.getItem(KEY) || ''; localStorage.removeItem(KEY); } catch {}
    if (lang === 'nl' && document.documentElement.lang !== 'nl') {
      location.replace(location.pathname.replace(/\/?$/, '/') + 'nl/?verzonden=1#contact');
    } else {
      document.querySelector('[data-thanks]')?.classList.remove('hidden');
    }
  }
</script>
