---
// All news and publications, newest first.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsMedia from './NewsMedia.astro';
import { t, url, articleUrl, co2, newsDate, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const items = (await getCollection('news', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base lang={lang} title={d.labels.news} page="news">
  <section class="wrap page-grid">
    <p class="crumb"><a href={url(lang)}>{d.news.home}</a> / {d.news.crumb}</p>
    <div class="page-main">
      <h1 class="page-title">{d.labels.news}</h1>
      <p class="page-intro" set:html={co2(d.news.archiveIntro)} />
      <div class="archive">
        {items.map((i) => (
          <article class="archive-row">
            <div class="archive-date">{newsDate(lang, i.data.date)}<br /><span class="type-tag">{i.data.type}</span></div>
            <div class="archive-text">
              <h2><a href={articleUrl(lang, i.id)} set:html={co2(i.data.title)} /></h2>
              <p set:html={co2((lang === 'nl' && i.data.excerpt_nl) || i.data.excerpt)} />
              <a class="read" href={articleUrl(lang, i.id)}>{d.news.readArticle}<span class="sr-only">: {i.data.title}</span></a>
            </div>
            <NewsMedia media={i.data.media} class="archive-media" />
          </article>
        ))}
      </div>
      <div class="follow">
        <p>{d.news.follow}</p>
        <a class="btn btn-primary" href={d.contact.linkedin_url}>{d.news.followCta}</a>
      </div>
    </div>
  </section>
</Base>
