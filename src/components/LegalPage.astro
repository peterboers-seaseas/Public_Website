---
// Privacy & cookies, and disclaimer. The texts live in src/i18n/en.ts and nl.ts under "legal".
import Base from '../layouts/Base.astro';
import { t, url, type Lang } from '../i18n';
interface Props { lang: Lang; page: 'privacy' | 'disclaimer' }
const { lang, page } = Astro.props;
const d = t(lang);
const L = d.legal[page];
type Sec = { h: string; p?: string[]; list?: string[]; after?: string[] };
const sections = L.sections as Sec[];
---
<Base lang={lang} title={L.title} page={page}>
  <section class="wrap page-grid">
    <p class="crumb"><a href={url(lang)}>{d.legal.home}</a> / <span set:html={L.crumb} /></p>
    <div class="page-main legal">
      <h1 class="page-title">{L.title}</h1>
      <p class="page-intro">{L.intro}</p>
      <p class="updated">{d.legal.updated}</p>
      {sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {(s.p ?? []).map((x) => <p set:html={x} />)}
          {s.list && <ul>{s.list.map((x) => <li set:html={x} />)}</ul>}
          {(s.after ?? []).map((x) => <p set:html={x} />)}
        </>
      ))}
    </div>
  </section>
</Base>
