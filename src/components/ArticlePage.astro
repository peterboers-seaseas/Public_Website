---
// One news article. The text is in English; the Dutch page shows the same text with a short note.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsMedia from './NewsMedia.astro';
import { t, url, articleUrl, co2, newsDate, type Lang } from '../i18n';
interface Props { lang: Lang; entry: CollectionEntry<'news'> }
const { lang, entry } = Astro.props;
const d = t(lang);
const { Content } = await render(entry);
const more = (await getCollection('news', (e) => !e.data.draft && e.id !== entry.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const site = Astro.site ?? new URL('https://www.seaseas.nl');
const pageUrl = new URL(articleUrl(lang, entry.id), site).href;
const desc = (lang === 'nl' && entry.data.excerpt_nl) || entry.data.excerpt;
---
<Base lang={lang} title={entry.data.title} description={desc} page={`news/${entry.id}`}>
  <article class="wrap page-grid">
    <aside class="article-aside">
      <p class="crumb"><a href={url(lang)}>{d.news.home}</a> / <a href={url(lang, 'news')}>{d.news.crumb}</a></p>
      <div class="article-meta">{d.news.published} {entry.data.published ?? newsDate(lang, entry.data.date)}<br /><span class="type-tag">{entry.data.type}</span></div>
      <div>
        <p class="share-label">{d.news.share}</p>
        <div class="share">
          <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} aria-label={d.news.shareLinkedin}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#09029B" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.1c0-1.22-.02-2.79-1.7-2.79-1.7 0-1.96 1.33-1.96 2.7V21h-4z"></path></svg>
          </a>
          <button type="button" class="share-btn" data-copy={pageUrl} data-copied={d.news.copied} aria-label={d.news.copyLink}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#09029B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1"></path><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"></path></svg>
          </button>
        </div>
      </div>
    </aside>
    <div class="page-main">
      <h1 class="article-title" set:html={co2(entry.data.title)} />
      {entry.data.bullets.length > 0 && (
        <ul class="article-bullets">{entry.data.bullets.map((b) => <li set:html={co2(b)} />)}</ul>
      )}
      <NewsMedia media={entry.data.media} wide class="article-media" />
      <div class="prose">
        {lang === 'nl' && d.news.englishOnly && <p class="lang-note" lang="nl">{d.news.englishOnly}</p>}
        <div lang="en"><Content /></div>
        <a class="back" href={url(lang, 'news')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          {d.news.back}
        </a>
      </div>
    </div>
  </article>

  <section class="wrap page-grid more-news" aria-labelledby="more-h">
    <h2 id="more-h" class="rh">{d.news.more}</h2>
    <div class="more-grid">
      {more.map((item) => (
        <article class="news-card">
          <NewsMedia media={item.data.media} />
          <div class="body">
            <div class="news-meta">{newsDate(lang, item.data.date)}, {item.data.type}</div>
            <h3 set:html={co2(item.data.title)} />
            <a class="card-link" href={articleUrl(lang, item.id)}>{d.news.readArticle}<span class="sr-only">: {item.data.title}</span><span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        const label = btn.getAttribute('aria-label')!;
        btn.setAttribute('aria-label', btn.dataset.copied!);
        btn.title = btn.dataset.copied!;
        setTimeout(() => { btn.setAttribute('aria-label', label); btn.title = ''; }, 2000);
      } catch { /* clipboard not available */ }
    });
  });
</script>
